# Shahnameh Metaverse Deployment Configuration
# Copy this file to .env and fill in your own values.

# Your wallet private key (with 0x prefix)
PRIVATE_KEY=0xYourPrivateKeyHere

# RPC URL for the target network
# Sepolia (testnet): https://ethereum-sepolia-rpc.publicnode.com
# Mainnet: https://eth.llamarpc.com
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional: Etherscan API key for contract verification
ETHERSCAN_API_KEY=YourApiKeyHere
